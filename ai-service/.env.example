# ai-service 配置样板：复制成 .env 再按需填写
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略（里面会有 key），.env.example 本身可以进仓库。
# 全部留空也能正常启动，只是走降级：
#   生成侧 → extractive（按知识库原文摘录，可溯源但不会组织语言）
#   检索侧 → tfidf（jieba 词袋，无 IDF 加权，置信度整体偏低）
# 把下面 LLM_* 三项填齐，生成侧立刻切换成真模型流式生成（无需改代码）。

# ---- 大模型：任何 OpenAI 兼容的 /chat/completions 都能用 ----
# 智谱 GLM   ：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
# DeepSeek   ：LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
# 本地 Ollama：LLM_BASE_URL=http://localhost:11434/v1              LLM_MODEL=qwen2.5:7b
#              （Ollama 不校验 key，LLM_API_KEY 随便填一个非空值即可）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=20

# ---- 多模态：拍照发布（A3）用的图片识别，协议同上 ----
# 例如智谱 glm-4v：VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4  VISION_MODEL=glm-4v
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ---- 检索参数（一般不用动，调参看这里）----
# 向量模型：优先用本地语义模型做召回，加载失败会自动降级为 jieba 词袋。
# 建议先下好（约 100MB）；huggingface.co 连不上时用镜像：
#   set HF_ENDPOINT=https://hf-mirror.com     # macOS/Linux: export HF_ENDPOINT=...
#   python -c "from huggingface_hub import snapshot_download; snapshot_download('BAAI/bge-small-zh-v1.5')"
# ⚠️ Windows 没开「开发者模式」时没有创建符号链接的权限，上面的缓存式下载会在最后一步报
#    WinError 1314；这时改用 local_dir 复制到任意目录，再把 EMB_MODEL 指向它：
#   python -c "from huggingface_hub import snapshot_download; snapshot_download('BAAI/bge-small-zh-v1.5', local_dir=r'C:\Users\你的用户名\.cache\bge-small-zh-v1.5')"
#   EMB_MODEL=C:\Users\你的用户名\.cache\bge-small-zh-v1.5
EMB_MODEL=BAAI/bge-small-zh-v1.5
EMB_FORCE_TFIDF=false
# 余弦相似度阈值：vector 模式用 SIM_THRESHOLD，tfidf 模式必须用低一档的那个
SIM_THRESHOLD=0.35
SIM_THRESHOLD_TFIDF=0.20
# 置信度低于它就强制拒答（宁可不答，不编造）
REFUSE_THRESHOLD=0.35
# 向量模式的置信度斜坡：绝对余弦 ≤floor 视为不相关、≥ceil 视为确定相关。
# 别改成「相对最高分」归一 —— 那样任何问题都会拿满分（见 retrieval.vector_confidence）
VEC_RAMP_FLOOR=0.45
VEC_RAMP_CEIL=0.75
# BM25 绝对强命中的加分上限（bm25_score/BM25_STRONG 封顶），只做小幅加成
BM25_STRONG=8.0
VEC_BONUS_WEIGHT=0.2
# 两路召回候选数 / 最终返回条数 / 多轮保留轮数
BM25_TOP_K=20
VEC_TOP_K=20
MAX_HITS=4
HISTORY_TURNS=3
# 开学季 / 毕业季加权
SEASON_BOOST=true

# ---- 运营端接口令牌：留空表示本地演示不校验 ----
OPS_TOKEN=
