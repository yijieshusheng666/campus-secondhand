# ============================================================
# 校园二手交易平台 —— AI 服务生产环境变量模板
# 放置路径：/opt/secondhand/ai-service/.env（chmod 600）
#
# 说明：config.py 会显式 load_dotenv(ai-service/.env)，且 override=False，
# 所以这里的值优先于系统环境变量。改完必须重启 secondhand-ai。
# ============================================================

# ---- 向量模式：2 核 2G 上强制走词袋降级 ----
# 不装 sentence-transformers（会拖来 torch，常驻 250-300MB），
# 于是 embedding 自动降级为 jieba + HashingVectorizer，mode="tfidf"。
# 想切回真向量：装 requirements.txt + 下模型 + 这里改 false + 重建索引。
EMB_FORCE_TFIDF=true
EMB_MODEL=BAAI/bge-small-zh-v1.5

# ---- 召回阈值：两种模式量级不同，必须分开配 ----
# tfidf 无 IDF 加权，余弦整体偏低（命中 0.21-0.33、噪声 <=0.20），所以取 0.20
SIM_THRESHOLD=0.35
SIM_THRESHOLD_TFIDF=0.20
REFUSE_THRESHOLD=0.35

# ---- 大模型：复用服务器上已有项目的智谱 GLM 凭据 ----
# deploy.sh 会从 /opt/campus/backend/.env 里读 LLM_* 写进来，不需要手填
LLM_BASE_URL=__LLM_BASE_URL__
LLM_API_KEY=__LLM_API_KEY__
LLM_MODEL=__LLM_MODEL__
LLM_TIMEOUT=20

# ---- 多模态（A3 拍照发布）----
VISION_BASE_URL=__VISION_BASE_URL__
VISION_API_KEY=__VISION_API_KEY__
VISION_MODEL=__VISION_MODEL__

# ---- 运营端接口令牌 ----
# 留空 = 不校验（仅限本地演示）。线上必须配，deploy.sh 自动生成。
OPS_TOKEN=__OPS_TOKEN__

# ---- 其他 ----
MAX_HITS=4
HISTORY_TURNS=3
SEASON_BOOST=true
