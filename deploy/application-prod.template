# ============================================================
# 校园二手交易平台 —— 生产环境 Spring Boot 配置模板
# 放置路径：/opt/secondhand/backend/application.properties（chmod 600）
#
# 为什么单独一份而不是复用仓库里的 application-template.properties：
#   生产要改端口、绑地址、上传目录、CORS 来源，逐项改容易漏。
#   deploy.sh 会把 <尖括号占位符> 替换成真实值，密码不出现在命令行里。
#
# ⚠️ 值里不要出现中文：MySQL 握手用 latin-1 传这些字段，
#    含非 ASCII 会抛一句毫无线索的 UnicodeEncodeError。
# ============================================================
spring.application.name=demo1

# ---- 监听地址 ----
# 只绑 127.0.0.1：公网入口统一走 Nginx(8091)，后端不对公网暴露。
# 端口 8081：80/8080/8090 已被本站另外三个项目占用。
server.address=127.0.0.1
server.port=8081

# ---- 数据库 ----
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/secondhand?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver
spring.datasource.username=__DB_USER__
spring.datasource.password=__DB_PASSWORD__

# ---- JPA ----
# update：保留历史数据。演示期间绝不能改成 create-drop（会清库）
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
# 关掉 open-in-view：事务边界收在 service 层，避免查询泄漏到视图渲染
spring.jpa.open-in-view=false

# ---- 上传 ----
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
# ⚠️ 上传目录**不在这里配**：UploadPaths 读的是 JVM 系统属性 -Dapp.upload.dir
#    或环境变量 APP_UPLOAD_DIR，Spring 的 properties 它压根不看（见该类注释）。
#    生产值由 systemd unit 里的 Environment=APP_UPLOAD_DIR=/opt/secondhand/uploads 提供。
#    千万别写成相对路径：相对路径按**启动目录**解析，换个目录启动就变成另一个位置，
#    表现是「上传成功但图片 404」。

# ---- AI 服务（Python 侧）----
# 必须是 127.0.0.1 而不是 localhost：localhost 会同时解析出 ::1 和 127.0.0.1，
# uvicorn 只监听 IPv4，于是「时好时坏地连不上」
ai.service.url=http://127.0.0.1:8010

# ---- 鉴权 ----
# 令牌 HMAC 密钥。留空也能启动（随机生成 + WARN），但每次重启会让所有
# 已登录用户掉线 —— 演示前必须填死。deploy.sh 会自动生成。
app.auth.secret=__AUTH_SECRET__
app.auth.ttl-seconds=604800

# ---- CORS ----
# 前端与接口同源（都在 8091），正常不会有跨域；但 Nginx 反代后浏览器
# 若直接访问 IP 也会带 Origin，这里显式放行本站来源，避免 403 Invalid CORS request。
app.cors.allowed-origins=http://__PUBLIC_HOST__:8091,http://127.0.0.1:8091
